{
  "tool": {
    "name": "ledger.history",
    "title": "Property assessment history",
    "description": "Read the dated assessments recorded for one listing URL, newest first, including conflicting observations. Page with offset (at most 20 per call).",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "minLength": 1,
          "maxLength": 2083
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 20,
          "default": 20
        }
      },
      "required": [
        "url"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      },
      "required": [
        "history"
      ],
      "additionalProperties": true
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  "cardea": {
    "version": 1,
    "handler": "ledger.history",
    "effect": "read",
    "timeout_seconds": 30,
    "max_output_bytes": 131072
  }
}
