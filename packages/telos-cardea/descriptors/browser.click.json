{
  "tool": {
    "name": "browser.click",
    "title": "Click on page",
    "description": "Open a public URL, click a link or button identified by visible text or CSS selector, and return the resulting page. Stateless: each call starts from the given URL.",
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "maxLength": 2048,
          "pattern": "^https?://"
        },
        "target": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300,
          "description": "Visible text or CSS selector of the element to click."
        }
      },
      "required": [
        "url",
        "target"
      ],
      "additionalProperties": false
    },
    "outputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "interactive": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string"
              },
              "text": {
                "type": "string"
              },
              "href": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "text"
            ],
            "additionalProperties": false
          }
        },
        "total_chars": {
          "type": "integer",
          "minimum": 0
        },
        "next_offset": {
          "type": [
            "integer",
            "null"
          ],
          "description": "Pass as offset to browser.open to read further; null when complete."
        },
        "structured": {
          "type": "object"
        },
        "rendered_empty": {
          "type": "boolean",
          "description": "True when the page rendered ~no extractable text but looks client-rendered (a JS app shell); not evidence of empty inventory."
        },
        "caveat": {
          "type": "string"
        }
      },
      "required": [
        "url",
        "title",
        "content",
        "interactive",
        "total_chars",
        "next_offset"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  "cardea": {
    "version": 1,
    "handler": "browser.click",
    "effect": "read",
    "timeout_seconds": 120,
    "max_output_bytes": 61440
  }
}
