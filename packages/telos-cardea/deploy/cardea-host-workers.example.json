        "/etc/fonts/conf.d"
      ],
      "env": {
        "PYTHONPATH": "/opt/cardea/apps/api/src",
        "PLAYWRIGHT_BROWSERS_PATH": "/opt/ms-playwright",
        "TELOS_CARDEA_BROWSER_FALLBACK": "1"
      }
    }
  }
}
